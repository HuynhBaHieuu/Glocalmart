# Sao chép thành .env khi chạy local. Trên Vercel khai báo trong Project Settings → Environment Variables.

# Chuỗi bí mật Django (bắt buộc khi deploy) — tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Supabase → nút "Connect" trên thanh trên cùng → Connection String → Method: "Transaction pooler" (cổng 6543)
# Lưu ý: KHÔNG dùng "Direct connection" (db.xxx.supabase.co:5432) vì chỉ hỗ trợ IPv6, Vercel không kết nối được.
DATABASE_URL=postgresql://postgres.<project-ref>:<mat-khau>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# (Tùy chọn) Lưu ảnh sản phẩm trên Supabase Storage — tạo bucket public tên "products"
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=products

# Để trống khi deploy (mặc định DEBUG=0 trên Vercel)
DEBUG=
